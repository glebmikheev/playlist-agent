# Server environment only. Do not put actual values in Git or frontend files.
GOOGLE_CLOUD_PROJECT=your-project-id
FIRESTORE_DATABASE=(default)
PUBLIC_ORIGIN=https://your-service-url.run.app
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_INPUT_TOKENS=24000
GEMINI_MAX_OUTPUT_TOKENS=4096
AGENT_TIMEOUT_SECONDS=180
GEMINI_API_KEY=replace-with-server-secret
COOKIE_SECRET=replace-with-at-least-32-random-characters
# Copy the actual free-tier limits for this model/project from AI Studio.
# RPM conservatively counts both token-count and generation requests.
PROVIDER_RPM=0
PROVIDER_TPM=0
PROVIDER_RPD=0
# 0 uses the direct peer. Configure the verified proxy chain before publication.
TRUSTED_XFF_HOPS=0
# Only for localhost; refused when running on Cloud Run.
LOCAL_HTTP=0
